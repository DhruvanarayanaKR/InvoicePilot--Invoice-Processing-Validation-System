# Local development settings. Replace the secret before deploying anywhere.
SECRET_KEY=replace-this-local-development-secret
APP_ENV=development
FLASK_DEBUG=1
# Optional: defaults to instance/invoicepilot.sqlite3
# DATABASE_PATH=C:\path\to\invoicepilot.sqlite3

# Optional Groq-powered explanations. Leave the key empty to keep AI disabled.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
